{
  "manifest_version": 3,
  "name": "NimGet",
  "version": "1.1.0",
  "description": "__MSG_manifestDescription__",
  "default_locale": "en",
  "key": "",
  "permissions": ["storage", "contextMenus", "webRequest"],
  "optional_permissions": ["downloads", "cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["http://127.0.0.1:51000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "NimGet",
    "default_popup": "popup.html"
  }
}
